{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "charts",
  "compatibility_date": "2026-06-02",
  "assets": {
    "directory": "./build",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "charts.mapsoft.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
